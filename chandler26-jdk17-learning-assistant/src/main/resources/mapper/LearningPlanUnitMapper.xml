<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chandler.learning.agent.mapper.learning.LearningPlanUnitMapper">

    <select id="selectMaxUnitNoIncludingDeleted" resultType="java.lang.Integer">
        SELECT MAX(unit_no)
        FROM learning_plan_unit
        WHERE plan_id = #{planId}
    </select>
</mapper>
