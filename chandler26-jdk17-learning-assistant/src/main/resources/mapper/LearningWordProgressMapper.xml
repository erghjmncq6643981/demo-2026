<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chandler.learning.agent.vocabulary.infrastructure.LearningWordProgressMapper">
    <update id="updateCardStatusBatch">
        UPDATE learning_word_progress
        SET card_status = #{cardStatus},
            update_time = #{updateTime}
        WHERE deleted = 0
          AND id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">#{id}</foreach>
    </update>

    <update id="updateBatch">
        UPDATE learning_word_progress
        <trim prefix="SET" suffixOverrides=",">
            <trim prefix="learning_state = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.learningState != null">
                        WHEN id = #{item.id} THEN #{item.learningState}
                    </if>
                </foreach>
            </trim>
            <trim prefix="mastery_requirement = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.masteryRequirement != null">
                        WHEN id = #{item.id} THEN #{item.masteryRequirement}
                    </if>
                </foreach>
            </trim>
            <trim prefix="recognition_score = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.recognitionScore != null">
                        WHEN id = #{item.id} THEN #{item.recognitionScore}
                    </if>
                </foreach>
            </trim>
            <trim prefix="recognition_stage = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.recognitionStage != null">
                        WHEN id = #{item.id} THEN #{item.recognitionStage}
                    </if>
                </foreach>
            </trim>
            <trim prefix="recognition_due_time = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.recognitionDueTime != null">
                        WHEN id = #{item.id} THEN #{item.recognitionDueTime}
                    </if>
                </foreach>
            </trim>
            <trim prefix="recognition_correct_count = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.recognitionCorrectCount != null">
                        WHEN id = #{item.id} THEN #{item.recognitionCorrectCount}
                    </if>
                </foreach>
            </trim>
            <trim prefix="recognition_wrong_count = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.recognitionWrongCount != null">
                        WHEN id = #{item.id} THEN #{item.recognitionWrongCount}
                    </if>
                </foreach>
            </trim>
            <trim prefix="spelling_score = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.spellingScore != null">
                        WHEN id = #{item.id} THEN #{item.spellingScore}
                    </if>
                </foreach>
            </trim>
            <trim prefix="spelling_stage = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.spellingStage != null">
                        WHEN id = #{item.id} THEN #{item.spellingStage}
                    </if>
                </foreach>
            </trim>
            <trim prefix="spelling_due_time = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.spellingDueTime != null">
                        WHEN id = #{item.id} THEN #{item.spellingDueTime}
                    </if>
                </foreach>
            </trim>
            <trim prefix="spelling_correct_count = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.spellingCorrectCount != null">
                        WHEN id = #{item.id} THEN #{item.spellingCorrectCount}
                    </if>
                </foreach>
            </trim>
            <trim prefix="spelling_wrong_count = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.spellingWrongCount != null">
                        WHEN id = #{item.id} THEN #{item.spellingWrongCount}
                    </if>
                </foreach>
            </trim>
            <trim prefix="exposure_count = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.exposureCount != null">
                        WHEN id = #{item.id} THEN #{item.exposureCount}
                    </if>
                </foreach>
            </trim>
            <trim prefix="scene_count = CASE" suffix="END,">
