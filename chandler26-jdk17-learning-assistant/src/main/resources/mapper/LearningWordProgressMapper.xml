                        WHEN id = #{item.id} THEN #{item.updateTime}
                    </if>
                </foreach>
            </trim>
        </trim>
        WHERE deleted = 0
          AND id IN
        <foreach collection="items" item="item" open="(" separator="," close=")">#{item.id}</foreach>
    </update>
</mapper>
