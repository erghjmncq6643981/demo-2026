                    </if>
                </foreach>
            </trim>
            <trim prefix="latest_plan_id = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.latestPlanId != null">
                        WHEN id = #{item.id} THEN #{item.latestPlanId}
                    </if>
                </foreach>
            </trim>
            <trim prefix="latest_unit_id = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.latestUnitId != null">
                        WHEN id = #{item.id} THEN #{item.latestUnitId}
                    </if>
                </foreach>
            </trim>
            <trim prefix="card_status = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.cardStatus != null">
                        WHEN id = #{item.id} THEN #{item.cardStatus}
                    </if>
                </foreach>
            </trim>
            <trim prefix="last_learned_time = CASE" suffix="END,">
                <foreach collection="items" item="item">
                    <if test="item.lastLearnedTime != null">
