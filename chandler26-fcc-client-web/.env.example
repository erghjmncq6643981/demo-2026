# Optional. Defaults to the current origin plus /ws/agent and follows HTTPS/WSS.
VITE_FCC_AGENT_WS_URL=/ws/agent

# SIP address, domain and per-agent credentials come from authenticated /auth/sip-config.

# JSON array accepted by RTCPeerConnection, for example [{"urls":"stun:stun.example.com:3478"}]
VITE_FCC_ICE_SERVERS_JSON=[]
